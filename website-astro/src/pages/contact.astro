---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getLangFromURL } from '../i18n/utils';

const lang = getLangFromURL(Astro.url.pathname);

const pageTitle = lang === 'zh' ? '商务合作 — AI Privacy Gateway' : 'Contact — AI Privacy Gateway';
const pageDesc = lang === 'zh'
  ? 'AI Privacy Gateway 企业级数据隐私解决方案。联系我们获取定制部署、SSO集成、专属技术支持。'
  : 'Get in touch for enterprise AI data privacy solutions. Custom deployment, SSO integration, and dedicated support.';

const heroTitle = lang === 'zh' ? '商务合作' : 'Contact Us';
const heroSubtitle = lang === 'zh'
  ? '企业级 AI 数据隐私解决方案，为你的组织量身定制'
  : 'Enterprise AI data privacy solutions tailored for your organization';

const formTitle = lang === 'zh' ? '发送需求' : 'Send a Message';
const formCompany = lang === 'zh' ? '公司名称' : 'Company';
const formCompanyPlaceholder = lang === 'zh' ? '请输入公司名称' : 'Enter your company name';
const formName = lang === 'zh' ? '姓名' : 'Name';
const formNamePlaceholder = lang === 'zh' ? '请输入你的姓名' : 'Enter your full name';
const formEmail = lang === 'zh' ? '邮箱' : 'Email';
const formEmailPlaceholder = lang === 'zh' ? '请输入工作邮箱' : 'Enter your work email';
const formMessage = lang === 'zh' ? '需求描述' : 'Requirements';
const formMessagePlaceholder = lang === 'zh' ? '请描述你的需求，包括部署规模、集成需求、时间预期等' : 'Describe your needs, including deployment scale, integration requirements, timeline, etc.';
const formSubmit = lang === 'zh' ? '发送咨询' : 'Send Inquiry';
const formPrivacy = lang === 'zh' ? '我们不会将你的信息用于任何其他目的。' : 'We will not use your information for any other purpose.';

const infoTitle = lang === 'zh' ? '联系方式' : 'Contact Information';
const infoEmail = 'contact@privacygw.dev';
const infoGithub = 'GitHub';
const infoGithubUrl = 'https://github.com/gunxueqiu6/ai-privacy-gateway';
const infoResponseTitle = lang === 'zh' ? '响应时间' : 'Response Time';
const infoResponse = lang === 'zh' ? '我们会在 1-2 个工作日内回复' : 'We typically respond within 1-2 business days';

const enterpriseTitle = lang === 'zh' ? '企业服务' : 'Enterprise Services';
const enterpriseItems = lang === 'zh' ? [
  '本地或 VPC 私有化部署',
  'SSO / SAML 单点登录集成',
  '定制合规报告（SOC2 / ISO27001）',
  'SLA 保障支持',
  '专属技术支持工程师',
  '高可用集群部署方案',
] : [
  'On-premise or VPC deployment',
  'SSO / SAML integration',
  'Custom compliance reports (SOC2 / ISO27001)',
  'SLA-backed support',
  'Dedicated support engineer',
  'High-availability cluster setup',
];
---

<Layout title={pageTitle} description={pageDesc} canonicalURL="https://privacygw.pages.dev/contact">
  <Nav />

  <section class="contact-hero">
    <div class="hero-orb-1"></div>
    <div class="hero-orb-2"></div>

    <div class="container">
      <div class="hero-content">
        <div class="section-label">{heroTitle}</div>
        <h1 class="hero-title">{heroTitle}</h1>
        <p class="hero-desc">{heroSubtitle}</p>
      </div>
    </div>
  </section>

  <section class="contact-body">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-form-col">
          <div class="glass contact-card">
            <h2 class="form-heading">{formTitle}</h2>
            <form action="/api/contact" method="POST" class="contact-form">
              <div class="form-group">
                <label for="company" class="form-label">{formCompany}</label>
                <input type="text" id="company" name="company" class="form-input" placeholder={formCompanyPlaceholder} required>
              </div>

              <div class="form-group">
                <label for="name" class="form-label">{formName}</label>
                <input type="text" id="name" name="name" class="form-input" placeholder={formNamePlaceholder} required>
              </div>

              <div class="form-group">
                <label for="email" class="form-label">{formEmail}</label>
                <input type="email" id="email" name="email" class="form-input" placeholder={formEmailPlaceholder} required>
              </div>

              <div class="form-group">
                <label for="message" class="form-label">{formMessage}</label>
                <textarea id="message" name="message" class="form-textarea" rows="5" placeholder={formMessagePlaceholder} required></textarea>
              </div>

              <p class="form-privacy">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                  <path d="M7 11V7a5 5 0 0110 0v4"/>
                </svg>
                {formPrivacy}
              </p>

              <button type="submit" class="btn btn-primary form-submit">{formSubmit}</button>
            </form>
          </div>
        </div>

        <div class="contact-info-col">
          <div class="glass contact-card">
            <h2 class="form-heading">{infoTitle}</h2>

            <div class="info-item">
              <div class="info-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
              </div>
              <div>
                <div class="info-label">Email</div>
                <a href="mailto:{infoEmail}" class="info-value">{infoEmail}</a>
              </div>
            </div>

            <div class="info-item">
              <div class="info-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
              </div>
              <div>
                <div class="info-label">GitHub</div>
                <a href={infoGithubUrl} class="info-value" target="_blank" rel="noopener noreferrer">{infoGithub}</a>
              </div>
            </div>

            <div class="info-item">
              <div class="info-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/>
                  <polyline points="12 6 12 12 16 14"/>
                </svg>
              </div>
              <div>
                <div class="info-label">{infoResponseTitle}</div>
                <div class="info-value">{infoResponse}</div>
              </div>
            </div>
          </div>

          <div class="glass contact-card">
            <h2 class="form-heading">{enterpriseTitle}</h2>
            <ul class="enterprise-list">
              {enterpriseItems.map((item) => (
                <li class="enterprise-item">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <style>
    /* ========== Hero ========== */
    .contact-hero {
      padding: 8rem 0 3rem;
      position: relative;
      overflow: hidden;
      text-align: center;
    }

    .hero-orb-1 {
      position: absolute;
      top: -20%;
      left: -10%;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, var(--primary-glow) 0%, rgba(134, 239, 172, 0.03) 40%, transparent 70%);
      border-radius: 50%;
      filter: blur(120px);
      pointer-events: none;
      animation: orb-float 25s ease-in-out infinite;
    }

    .hero-orb-2 {
      position: absolute;
      bottom: -30%;
      right: -10%;
      width: 550px;
      height: 550px;
      background: radial-gradient(circle, var(--accent-glow) 0%, rgba(167, 139, 250, 0.03) 40%, transparent 70%);
      border-radius: 50%;
      filter: blur(120px);
      pointer-events: none;
      animation: orb-float 30s ease-in-out infinite -10s;
    }

    @keyframes orb-float {
      0%, 100% { transform: translate(0, 0); }
      33% { transform: translate(30px, -30px); }
      66% { transform: translate(-20px, 20px); }
    }

    .hero-content {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero-title {
      font-size: 3.5rem;
      font-weight: 700;
      margin-bottom: 1rem;
      background: linear-gradient(135deg, var(--text-primary), var(--primary));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-desc {
      color: var(--text-muted);
      font-size: 1.1rem;
      max-width: 560px;
      line-height: 1.7;
    }

    /* ========== Body ========== */
    .contact-body {
      padding: 2rem 0 6rem;
    }

    .contact-grid {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 2rem;
      align-items: start;
    }

    .contact-card {
      padding: 2rem;
      margin-bottom: 1.5rem;
    }

    .form-heading {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 1.5rem;
      color: var(--text-primary);
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--border);
    }

    /* ========== Form ========== */
    .contact-form {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .form-label {
      font-size: 0.88rem;
      font-weight: 500;
      color: var(--text-secondary);
    }

    .form-input,
    .form-textarea {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 0.75rem 1rem;
      font-size: 0.92rem;
      color: var(--text-primary);
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      transition: border-color 0.25s ease, box-shadow 0.25s ease;
      outline: none;
      width: 100%;
    }

    .form-input:focus,
    .form-textarea:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(134, 239, 172, 0.10);
    }

    .form-input::placeholder,
    .form-textarea::placeholder {
      color: var(--text-dim);
    }

    .form-textarea {
      resize: vertical;
      min-height: 120px;
    }

    .form-privacy {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.8rem;
      color: var(--text-muted);
      line-height: 1.5;
    }

    .form-privacy svg {
      flex-shrink: 0;
      color: var(--primary);
    }

    .form-submit {
      align-self: flex-start;
    }

    /* ========== Info ========== */
    .info-item {
      display: flex;
      align-items: flex-start;
      gap: 0.85rem;
      padding: 1rem 0;
      border-bottom: 1px solid var(--border);
    }

    .info-item:last-of-type {
      border-bottom: none;
    }

    .info-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: rgba(134, 239, 172, 0.06);
      border: 1px solid rgba(134, 239, 172, 0.12);
      color: var(--primary);
      flex-shrink: 0;
    }

    .info-label {
      font-size: 0.78rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-muted);
      margin-bottom: 0.2rem;
    }

    .info-value {
      font-size: 0.92rem;
      color: var(--text-primary);
    }

    .info-value a {
      color: var(--primary);
    }

    /* ========== Enterprise List ========== */
    .enterprise-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }

    .enterprise-item {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 0.9rem;
      color: var(--text-secondary);
      line-height: 1.5;
    }

    .enterprise-item svg {
      flex-shrink: 0;
    }

    /* ========== Responsive ========== */
    @media (max-width: 768px) {
      .contact-hero {
        padding: 6rem 0 2rem;
      }

      .hero-title {
        font-size: 2.25rem;
      }

      .hero-desc {
        font-size: 1rem;
      }

      .contact-grid {
        grid-template-columns: 1fr;
      }

      .contact-body {
        padding: 1.5rem 0 4rem;
      }

      .contact-card {
        padding: 1.5rem;
      }

      .hero-orb-1, .hero-orb-2 {
        width: 350px;
        height: 350px;
        opacity: 0.4;
      }
    }

    @media (max-width: 480px) {
      .hero-title {
        font-size: 1.8rem;
      }

      .form-submit {
        width: 100%;
        justify-content: center;
      }

      .contact-card {
        padding: 1.25rem;
      }
    }
  </style>
</Layout>
